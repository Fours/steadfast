{
  "name": "@kylewillett/steadfast",
  "version": "0.0.0",
  "private": true,
  "description": "Durable AI agents on Troupe actors: supervised model and tool calls, crash recovery from a journal, and exact replay.",
  "license": "MIT",
  "author": "Kyle Willett",
  "homepage": "https://github.com/Fours/steadfast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fours/steadfast.git"
  },
  "bugs": {
    "url": "https://github.com/Fours/steadfast/issues"
  },
  "keywords": [
    "agent",
    "agents",
    "ai-agents",
    "llm",
    "durable",
    "actor-model",
    "event-sourcing",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testkit": {
      "types": "./dist/testkit/index.d.ts",
      "import": "./dist/testkit/index.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic/index.d.ts",
      "import": "./dist/anthropic/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "example": "npm run build --silent && node examples/incident-triage/main.ts",
    "example:check": "node scripts/check-example.ts"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@kylewillett/troupe": "^0.3.2"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@eslint/js": "^10.0.1",
    "@kylewillett/troupe": "^0.3.2",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
