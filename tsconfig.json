{
  // Editor and test config: src, tests and examples, with Node types for the tests.
  // tsconfig.build.json builds src/ without Node types, which keeps the core runtime-agnostic
  // (decision 0004). `npm run typecheck` runs both.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    // Node runs examples/ by stripping types, which needs relative imports to end in .ts.
    "allowImportingTsExtensions": true,
    // The examples import the package by name, which Node resolves to dist/. Type-checking reads
    // src/ instead, so it passes before a build.
    "paths": {
      "@kylewillett/steadfast": ["./src/index.ts"],
      "@kylewillett/steadfast/testkit": ["./src/testkit/index.ts"],
      "@kylewillett/steadfast/anthropic": ["./src/anthropic/index.ts"],
      "@kylewillett/steadfast/openai": ["./src/openai/index.ts"]
    }
  },
  "include": ["src", "test", "examples", "scripts", "*.config.ts"],
  // Node's types already declare these globals, and skipLibCheck would hide any clash, so the
  // editor and tests see only Node's. The build config puts the file back.
  "exclude": ["src/globals.d.ts"]
}
